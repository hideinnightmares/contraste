# ─── Sitio ────────────────────────────────────────────────────────────────
# URL pública canónica (sin barra final). Se usa en canonical, Open Graph, sitemaps y RSS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modo demostración: contenido ficticio marcado como DEMO y excluido de buscadores.
# Pasar a "false" solo cuando el contenido sea real.
CONTRASTE_DEMO_MODE=true

# Fuente de contenido del sitio: demo (por defecto). "database" y "cms" requieren
# implementar ArticleRepository (ver docs/ARQUITECTURA.md).
CONTENT_SOURCE=demo

# ─── Pipeline de automatización ───────────────────────────────────────────
# human: todo borrador pasa por una persona (por defecto). policy: publica solo lo que cumple la política.
CONTRASTE_REVIEW_MODE=human
# Redactor con IA (solo si se corre `npm run pipeline -- --write`). Ver docs/AUTOMATIZACION.md.
# gemini: plan gratuito de Google AI Studio (por defecto si hay GEMINI_API_KEY).
# anthropic: Claude, pago por uso.
# CONTRASTE_WRITER=gemini

# Gemini. La clave se crea en https://aistudio.google.com/apikey.
# Las claves de los redactores van en .env.pipeline (lo lee solo el pipeline), nunca en .env.local:
# el build de Cloudflare incluye todo .env.local en el código publicado. Nunca en el repositorio.
# En el plan gratuito, Google usa lo enviado para mejorar sus productos.
# GEMINI_API_KEY=
# Modelos en orden de preferencia, separados por coma. Si uno está saturado o sin cupo, se usa el siguiente.
# CONTRASTE_GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# "pago" al contratar el plan pago de Gemini. En el gratis, Google entrena con lo que recibe y el
# redactor no recibe el texto completo de los sitios que se lo prohíben (Google-Extended).
# CONTRASTE_GEMINI_PLAN=pago

# Máximo de borradores por corrida (4 si no se define): primero lo que cubren más fuentes.
# CONTRASTE_MAX_BORRADORES_POR_CORRIDA=4
# Memoria entre corridas: archivo donde recordar las notas de las últimas 24 horas (sin su texto).
# CONTRASTE_MEMORIA=.cache/pipeline/memoria.json

# Base de datos del pipeline (Supabase), también en .env.pipeline. La URL no es secreta; la clave
# secreta (sb_secret_...) se crea en Project Settings > API Keys > Secret keys y salta las reglas de
# acceso: nunca en el sitio ni en el navegador. Ver docs/BASE-DE-DATOS.md.
# SUPABASE_URL=https://xeytiarseubrzrnmyomp.supabase.co
# SUPABASE_SECRET_KEY=

# Claude. Credenciales: ANTHROPIC_API_KEY o un perfil de `ant auth login`.
# ANTHROPIC_API_KEY=
# CONTRASTE_ANTHROPIC_MODEL=claude-opus-5-5
# CONTRASTE_ANTHROPIC_EFFORT=high

# ─── Newsletter ───────────────────────────────────────────────────────────
# Deshabilitado: el sitio es estático y todavía no hay dónde guardar suscripciones.
# Se configura en src/config/newsletter.ts. Ver docs/NEWSLETTER.md.

# ─── Google AdSense ───────────────────────────────────────────────────────
# ID de editor (ca-pub-XXXXXXXXXXXXXXXX). Lo da AdSense al aprobar el sitio. No inventar.
# NEXT_PUBLIC_ADSENSE_CLIENT=
# IDs de bloques de anuncios, uno por posición:
# NEXT_PUBLIC_ADSENSE_SLOT_TOP=
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_INFEED=
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_SIDEBAR=
# NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_INLINE=
# NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_SIDEBAR=
# NEXT_PUBLIC_ADSENSE_SLOT_SECTION_INFEED=
# NEXT_PUBLIC_ADSENSE_SLOT_SECTION_SIDEBAR=
# Marcadores grises en los espacios sin anuncio. Apagar en producción.
NEXT_PUBLIC_AD_PLACEHOLDERS=true
