# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# .env.production solo lleva datos públicos (la dirección del sitio); cf:build corta si aparece un secreto.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# caché de fotos generadas (scripts/postbuild.ts); el sitio armado va en /out/
/.cache/

# estado local de wrangler y variables locales de Cloudflare
/.wrangler/
.dev.vars*
!.dev.vars.example

# datos locales (suscripciones de prueba, salidas del pipeline)
/.data/
/test-results/
/playwright-report/
