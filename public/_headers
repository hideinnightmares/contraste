# Encabezados de Cloudflare para el sitio estático (Next no los aplica con output: 'export').
# La política de contenido (CSP) queda para cuando se active AdSense: sus dominios cambian
# seguido y una CSP mal ajustada rompe los anuncios. Ver docs/ARQUITECTURA.md, "Seguridad".
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# Archivos con hash en el nombre: no cambian nunca.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Versiones de fotos: el nombre no cambia si se reemplaza la original, así que caché corta.
/_img/*
  Cache-Control: public, max-age=86400

# El RSS como RSS (Cloudflare lo serviría como XML genérico por la extensión).
/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
